{
  "manifest_version": 3,
  "name": "laeria — community verdict",
  "version": "0.1.0",
  "description": "Reads what communities actually say about the thing you're looking at, and watches what you bought.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://laeria-ai-backend.onrender.com/*",
    "http://localhost:8000/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "laeria"
  }
}
