# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key       # service role for backend; never expose to frontend
SUPABASE_ANON_KEY=your-anon-key          # used by frontend

# ---- OpenRouter ----
OPENROUTER_API_KEY=sk-or-...
# Benchmarked 2026-08-06 on the real synthesis prompt, 2 runs each:
#   anthropic/claude-haiku-4.5   22.8-24.6s   4 red flags   <- tightest spread
#   deepseek/deepseek-v4-flash   17.3-18.6s   2 red flags   (fast median, 287s tail seen)
#   deepseek/deepseek-v4-pro     16.6-50.0s   0 red flags   <- erratic, missed the flags
#   anthropic/claude-sonnet-4.5  35.0-47.1s   3 red flags
# Predictability matters more than the median here: the user waits on the
# SLOWER of two parallel halves, so a long tail costs more than a high mean.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Per-request ceiling, multiplied by LLM_MAX_RETRIES+1 for the true worst case.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Reddit (PRAW) ----
# Register an app at https://www.reddit.com/prefs/apps (type: script)
REDDIT_CLIENT_ID=your-client-id
REDDIT_CLIENT_SECRET=your-client-secret
REDDIT_USER_AGENT=laeria.ai/0.1 by u/yourusername
REDDIT_USERNAME=yourusername
REDDIT_PASSWORD=your-password

# ---- Obsidian Local REST API ----
# Install the "Local REST API" community plugin, copy its API key
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=your-obsidian-rest-api-key
OBSIDIAN_VERIFY_SSL=false                 # plugin uses a self-signed cert by default

# ---- Owner (single-user mode until auth lands) ----
# UUID of the Supabase auth user that owns monitored items/alerts.
# Dashboard -> Authentication -> Users -> Add user -> copy its id.
OWNER_USER_ID=

# ---- x402 payments ----
# Avalanche, the chain this build showcases:
#   eip155:43113 = Avalanche Fuji (testnet, default — custodial funding runs here)
#   eip155:43114 = Avalanche C-Chain mainnet. Direct transfers (fund_agent) stay
#     refused; ONLY non-custodial settlement (transferFrom) may move mainnet
#     funds, and only when ALLOW_MAINNET_SETTLEMENT is set — see below.
X402_NETWORK=eip155:43113
# The facilitator MUST support X402_NETWORK — they are not independent knobs.
# Switching the network without switching this leaves every payment failing at
# settle time with an error that does not name the cause.
#   eip155:43113 -> https://facilitator.ultravioletadao.xyz   (Avalanche Fuji)
X402_FACILITATOR_URL=https://facilitator.ultravioletadao.xyz
X402_AGENT_PRIVATE_KEY=
X402_AGENT_ADDRESS=
X402_TREASURY_ADDRESS=
X402_TREASURY_PRIVATE_KEY=
ACTION_VENDOR_URL=http://127.0.0.1:8000/vendor/deep-report
# Who receives the stablecoin when a card purchase settles on-chain.
# Blank = the treasury address above (the demo's merchant).
MERCHANT_SETTLEMENT_ADDRESS=
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Extra networks to register the payment signer for (comma-separated). Any
# entry that is not a known testnet is refused unless X402_ALLOW_MAINNET is
# explicitly set — an unrecognised id counts as mainnet, not as safe.
X402_EXTRA_NETWORKS=

# ---- x402 self-facilitation (WS-x402) ----
# No hosted facilitator settles XSGD on Avalanche, so the demo vendor settles
# its own x402 payments: it verifies the buyer's EIP-3009 signature and submits
# transferWithAuthorization on-chain via a relayer. XSGD is a Circle FiatToken,
# so it supports EIP-3009 natively. Turn this on for the x402-XSGD rail.
X402_SELF_FACILITATE=false
# The relayer that submits the settle tx and pays gas (holds no user funds).
# Blank falls back to X402_TREASURY_PRIVATE_KEY.
X402_RELAYER_PRIVATE_KEY=
# The token's EIP-712 domain — FiatToken uses {name: <token name>, version:"2"}.
# Must match the token on-chain or transferWithAuthorization reverts.
X402_ASSET_EIP712_NAME=XSGD
X402_ASSET_EIP712_VERSION=2
# Mainnet x402 also needs X402_ALLOW_MAINNET=true (registers the buyer signer on
# a real-money network) in addition to STABLECOIN_CONTRACT + X402_NETWORK=43114.

# ---- Funding token ----
# Overrides the network's default token. Blank = use the default, which is
# already XSGD on both Avalanche networks — nothing needs setting here for the
# standard demo.
#   Real XSGD, VERIFIED on-chain 2026-08-12: Avalanche C-Chain MAINNET
#   0xb2F85b7AB3c2b6f62DF06dE6aE7D09c010a5096E, symbol XSGD, 6 decimals.
#   No public Fuji deployment exists — deploy infra/contracts/XSGDTest.sol and
#   point STABLECOIN_CONTRACT at it for a testnet demo.
#   Leave STABLECOIN_DECIMALS BLANK: decimals() is read off the contract and
#   this is only the fallback for an unreachable RPC.
STABLECOIN_CONTRACT=
STABLECOIN_SYMBOL=
STABLECOIN_DECIMALS=

# ---- Per-user + non-custodial wallets ----
# Fernet key encrypting per-user custodial keys at rest. Blank = provisioning
# off (everyone falls back to the single env wallet, i.e. pre-003 behaviour).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEY=
# The owner keeps the env wallet; other users get their own. Leave true.
OWNER_USES_ENV_WALLET=true

# ---- Non-custodial settlement (the mainnet flip lives here) ----
# A connected wallet approves the OPERATOR (the X402_AGENT address) to spend up
# to a cap; settlement is transferFrom, signed by the operator, which holds no
# user funds. This is the ONLY real-money path.
#
# OFF by default: on any mainnet, _transfer_from refuses unless this is true.
ALLOW_MAINNET_SETTLEMENT=false
# Hard ceiling on any single settlement, in TOKEN UNITS (XSGD, not USD — no FX
# conversion happens). Belt-and-suspenders over the mandate and the allowance.
# Must be >= the purchase total or a real buy is refused (a safety default).
MAX_SETTLEMENT=5
#
# THE MAINNET FLIP — set these together to move real XSGD on Avalanche C-Chain:
#   X402_NETWORK=eip155:43114
#   STABLECOIN_CONTRACT=0xb2F85b7AB3c2b6f62DF06dE6aE7D09c010a5096E
#   ALLOW_MAINNET_SETTLEMENT=true
#   MAX_SETTLEMENT= (>= the purchase total in XSGD, and no more than you'll spend)
#   MERCHANT_SETTLEMENT_ADDRESS= a wallet that is NOT the buyer/treasury, or
#     settlement is a pointless self-transfer.
# Off-chain prereqs: fund the OPERATOR (X402_AGENT address) with a little real
# AVAX for gas, and have the connected wallet approve it on mainnet.

# ---- Card issuance ----
# mock = offline fake issuer | stripe = Stripe Issuing test mode | straitsx = event sandbox
CARD_ISSUER=mock
STRIPE_API_KEY=sk_test_...
STRIPE_CARDHOLDER_ID=

# ---- StraitsX card MCP (the REAL issuer, non-custodial) ----
# The card is a real StraitsX Visa, paid for by an EIP-3009 XSGD payment the
# USER signs in their own wallet (x402 over MCP at card.straitsx.ai). Backend
# builds the challenge and submits the signed payload; it never holds the key.
#   sandbox    = Avalanche Fuji 43113, test XSGD, no whitelist (dev/testing)
#   production = Avalanche C-Chain 43114, real XSGD, wallet must be organizer-
#                whitelisted. Flip this one var to go live.
# The paying wallet is whoever connects on the Commerce page (holds the XSGD).
STRAITSX_CARD_ENV=sandbox

# ---- Demo storefront (Shopify dev store) ----
SHOP_STORE_URL=https://your-store.myshopify.com
SHOP_STOREFRONT_PASSWORD=
# bogus = Shopify Bogus Gateway magic PANs | real = actual card PAN (event)
CHECKOUT_GATEWAY_PROFILE=bogus
# chromium = Playwright-bundled build | chrome = system Chrome (SAC fallback)
PLAYWRIGHT_CHANNEL=chromium
# true = visible browser window (stage demo); false = headless (dev/tests)
BROWSER_HEADED=false
# Shipping profile for agent checkout (test orders only). US default because
# a fresh dev store only ships to the US; change if you add other zones.
SHIPPING_NAME=Laeria Agent
SHIPPING_EMAIL=laeria.agent.demo@gmail.com
SHIPPING_ADDRESS1=123 Demo Street
SHIPPING_CITY=San Francisco
SHIPPING_POSTAL_CODE=94111
SHIPPING_COUNTRY=US
SHIPPING_ZONE=CA
# Allowance for shipping+taxes above product price (mandate caps still bound it)
CHECKOUT_SHIPPING_BUFFER_USD=20.0

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- StraitsX card issuing (fill at the event) ----
# Every unknown is an env var so going live is config, not code.
# Booth questions: sandbox base URL, auth scheme, spend-limit granularity
# (per-authorization vs total), whether PAN/CVC is API-retrievable in sandbox,
# terminate vs freeze for single-use disposal, XSGD vs XUSD for a USD merchant.
STRAITSX_BASE_URL=
STRAITSX_API_KEY=
STRAITSX_AUTH_HEADER=Authorization
STRAITSX_AUTH_PREFIX=Bearer 
STRAITSX_CARDS_PATH=/v1/cards
STRAITSX_CARD_PATH=/v1/cards/{id}
STRAITSX_CARD_SECRETS_PATH=/v1/cards/{id}/secrets
STRAITSX_CARD_TXNS_PATH=/v1/cards/{id}/transactions
STRAITSX_CANCEL_METHOD=POST
STRAITSX_CANCEL_PATH=/v1/cards/{id}/terminate
STRAITSX_CURRENCY=USD
STRAITSX_LIMIT_INTERVAL=per_authorization

# ---- Amazon Bedrock Guardrails (the safety boundary around the agent) ----
# This is NOT an inference provider. OpenRouter still does all the reasoning.
# Bedrock answers one question at each trust boundary: may this text enter or
# leave the agent? See services/bedrock_guardrails.py.
#
# CREDENTIALS ARE NOT LISTED HERE ON PURPOSE.
# boto3 uses its own provider chain, so give it credentials the standard way:
#   - locally:    AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY exported in your
#                 shell, or a profile in ~/.aws/credentials
#   - deployed:   an IAM role attached to the task/instance (no keys at all)
# Nothing in this application reads or stores an access key. Note that values
# written into backend/.env are read by Settings but NOT exported to the
# process environment, so boto3 will not see credentials placed there unless
# your process manager exports them (uvicorn --env-file .env does).
#
# The IAM identity needs one action, bedrock:ApplyGuardrail, scoped to this
# guardrail and the APAC cross-region guardrail-profile resources it can route
# to. Do not widen it.
AWS_REGION=ap-southeast-1
BEDROCK_GUARDRAIL_ID=
# A numbered version, never DRAFT — DRAFT is mutable and could change under a
# running agent. Enabled with DRAFT set, every protected request is refused.
BEDROCK_GUARDRAIL_VERSION=1
# false = clean no-op, no AWS calls, no credentials needed (the default, and
# what the test suite runs against). true = enforced, and a failed safety
# check refuses the request rather than continuing unverified.
BEDROCK_GUARDRAILS_ENABLED=false
